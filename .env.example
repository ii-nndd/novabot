# ===== إعدادات بوت نوفا (انسخ الملف إلى .env ثم عبّي القيم) =====
# لا ترفع ملف .env إلى GitHub أبداً.

# ====================================================================
# 🆔 هوية السيرفر (أهم شي — أي بوت جديد لازم يعبي هذي)
# ====================================================================
# آيدي السيرفر اللي يشتغل فيه البوت.
# ⚠️ مهم جداً: البوت بوضع «سيرفر واحد» (PUBLIC_BOT=0) — لو GUILD_ID غلط
#    أو فاضي، البوت يطلع من السيرفر فوراً ولا يرد على أي أمر.
#    تجيبه من ديسكورد: إعدادات السيرفر ← «الأدوات» ← «معرّف السيرفر»
GUILD_ID=
# آيدي حسابك أنت (صاحب البوت) — هو «الملكي» الأعلى: يفتح اللوحة وكل الأوامر.
# تجيبه: اضغط على صورتك ← «نسخ معرّف المستخدم» (فعّل وضع المطور أولاً)
ARTHUR_ID=
# آيدي حساب ثاني تشاركه نفس الصلاحيات (اختياري — اتركه فاضي لو ما تبي)
SPECIAL_USER_ID=
# آيدي رتبة «الملكي» بالسيرفر (اختياري — أعضاء هذي الرتبة يعاملهم البوت كملوك)
ROYAL_ROLE_ID=
# آيدي الروم الصوتي اللي يدخله البوت 24/7 (اختياري — فاضي = ما يدخل فويس)
VOICE_CHANNEL_ID=
# آيدي روم ترحيب الكتابة (اختياري — فاضي = مطفّي)
WELCOME_TEXT_CHANNEL_ID=
# آيدي روم سجل أوامر الإدارة (اختياري — فاضي = مطفّي)
LOG_CHANNEL_ID=
# آيدي رتبة «بدون احترام» (اختياري — اتركه فاضي)
DISRESPECT_ROLE_ID=
# 💘 مسموح لهم باستخدام أمر /حب زيادة على الملكيين (آيديات مفصولة بفاصلة)
#    فاضي = الملكي/الإدارة فقط يستخدمونه
LOVE_ALLOW_IDS=
# 👑 «ملكية بالسر»: ناس يعاملهم البوت كملكي (نفس صلاحيات رتبة الملكي)
#    بدون صلاحيات صاحب البوت (ما يفتحون اللوحة ولا الصفحات الخاصة) — آيديات بفاصلة
SECRET_ROYAL_IDS=1550879705115398156

# --- إلزامي: تشغيل البوت ---
# توكن البوت من Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# --- لوحة التحكم /dashboard (OAuth2) ---
# من Developer Portal > OAuth2 > General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# مفتاح عشوائي طويل لتوقيع الجلسات (أي نص سري طويل)
SESSION_SECRET=

# --- رابط النشر العام (يُستخدم في OAuth Redirect URI) ---
# Render يحطّه تلقائياً في RENDER_EXTERNAL_URL، أو حطّه يدوياً
PUBLIC_URL=
RENDER_EXTERNAL_URL=

# --- التخزين الدائم (مستحسن بشدة) ---
# بدون MONGODB_URI: كل التعديلات تضيع عند إعادة التشغيل
MONGODB_URI=
MONGODB_DB=divelbot

# --- لوحة تحرير الردود /panel ---
ADMIN_PASSWORD=

# --- اختياري ---
# فعّل Server Members Intent في موقع المطورين ثم حط القيمة 1 (للبحث بالاسم والترحيب)
MEMBERS_INTENT=1
# نبض البقاء (يمنع نوم الخدمة على Render المجاني): 1 مفعّل، 0 مطفي
# تنبيه: 1 يستهلك ~744 ساعة من أصل 750 ساعة مجانية بالشهر → لو الخدمة انسحبت (Suspended) حط 0
KEEPALIVE=1
# نفق Cloudflare التلقائي: 1 يفتح رابط HTTPS عام للوحة (للاستضافات اللي ما تعطي رابط مثل HeavenCloud/Wispbyte)
# على Render اتركه فاضي/0 (Render يعطي رابط HTTPS أصلاً)
TUNNEL=0
# --- رابط ثابت للأبد عبر Tailscale Funnel (الأفضل: تسجّل redirect_uri مرة وحدة) ---
# سجّل مجاناً في https://login.tailscale.com/start (بلا بطاقة) ثم Admin console > Settings > Keys
# > Generate auth key (Reusable) والصق المفتاح هنا. النتيجة: رابط ثابت https://<TS_HOSTNAME>.<tailnet>.ts.net
# ⚠️ لا تشارك هذا المفتاح مع أي أحد ولا ترفعه إلى GitHub.
TS_AUTHKEY=
# اسم الجهاز داخل Tailscale (يصير جزء من الرابط الثابت)
TS_HOSTNAME=nova-bot
# منفذ سيرفر الويب (Render يحدده تلقائياً)
PORT=3000
# مجلد حفظ البيانات المؤقتة
DATA_DIR=
# ===== 🌐 وضع البوت (مهم لقوانين الاستضافة) =====
# 0 (الافتراضي) = البوت **لسيرفر واحد فقط** (سيرفر نوفا) — يطلع من أي سيرفر ثاني فوراً
#     ✅ هذا المطلوب لمعظم استضافات البوتات المجانية (ممنوع «بوت عام» يخدم سيرفرات كثيرة)
# 1 = البوت لكل السيرفرات (نظام التفعيل من صفحة «السيرفرات 🌐»)
#     ⚠️ لا تحطه 1 إلا لو الاستضافة تسمح صريحاً بالبوتات العامة (VPS مثلاً)
PUBLIC_BOT=0

# ===== 🤖 الذكاء الاصطناعي (اختياري) =====
# مفتاح مجاني من Google AI Studio (aistudio.google.com ← Get API key) — بلا بطاقة بنكية
# تقدر تحطه هنا، أو تحفظه من اللوحة: صفحة «الذكاء الاصطناعي 🤖» (يُحفظ في aicfg.json)
# ⚠️ لا تشارك هالمفتاح مع أي أحد ولا ترفعه على Git
AI_KEY=

# ===== 🔁 نسخة البوت لسيرفر ثاني (تسليم) =====
# شغّل:  node newbot.js   → يطلع لك مجلد + ZIP جاهزين (شوف deploy/COPY-BOT.md)
# هذان المتغيران ينكتبان تلقائياً بالنسخة الجديدة عشان ما تنتقل شخصيات/أزواج حب سيرفر نوفا:
#   PERSONAS_JSON={}          (فاضي = كل الأعضاء يعاملهم البوت بنفس الأسلوب)
#   LOVE_FIXED_JSON=[]        (فاضي = يمسح أزواج الحب الثابتة حقت سيرفر نوفا)
# اتركهم فاضيين بسيرفر نوفا = نفس السلوك الأصلي بالضبط (ما يتغير شي).
PERSONAS_JSON=
LOVE_FIXED_JSON=
