# ===== إعدادات بوت نوفا (انسخ الملف إلى .env ثم عبّي القيم) =====
# لا ترفع ملف .env إلى GitHub أبداً.

# --- إلزامي: تشغيل البوت ---
# توكن البوت من Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# --- لوحة التحكم /dashboard (OAuth2) ---
# من Developer Portal > OAuth2 > General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# مفتاح عشوائي طويل لتوقيع الجلسات (أي نص سري طويل)
SESSION_SECRET=

# --- رابط النشر العام (يُستخدم في OAuth Redirect URI) ---
# Render يحطّه تلقائياً في RENDER_EXTERNAL_URL، أو حطّه يدوياً
PUBLIC_URL=
RENDER_EXTERNAL_URL=

# --- التخزين الدائم (مستحسن بشدة) ---
# بدون MONGODB_URI: كل التعديلات تضيع عند إعادة التشغيل
MONGODB_URI=
MONGODB_DB=divelbot

# --- لوحة تحرير الردود /panel ---
ADMIN_PASSWORD=

# --- اختياري ---
# فعّل Server Members Intent في موقع المطورين ثم حط القيمة 1 (للبحث بالاسم والترحيب)
MEMBERS_INTENT=1
# نبض البقاء (يمنع نوم الخدمة على Render المجاني): 1 مفعّل، 0 مطفي
# تنبيه: 1 يستهلك ~744 ساعة من أصل 750 ساعة مجانية بالشهر → لو الخدمة انسحبت (Suspended) حط 0
KEEPALIVE=1
# نفق Cloudflare التلقائي: 1 يفتح رابط HTTPS عام للوحة (للاستضافات اللي ما تعطي رابط مثل HeavenCloud/Wispbyte)
# على Render اتركه فاضي/0 (Render يعطي رابط HTTPS أصلاً)
TUNNEL=0
# --- رابط ثابت للأبد عبر Tailscale Funnel (الأفضل: تسجّل redirect_uri مرة وحدة) ---
# سجّل مجاناً في https://login.tailscale.com/start (بلا بطاقة) ثم Admin console > Settings > Keys
# > Generate auth key (Reusable) والصق المفتاح هنا. النتيجة: رابط ثابت https://<TS_HOSTNAME>.<tailnet>.ts.net
# ⚠️ لا تشارك هذا المفتاح مع أي أحد ولا ترفعه إلى GitHub.
TS_AUTHKEY=
# اسم الجهاز داخل Tailscale (يصير جزء من الرابط الثابت)
TS_HOSTNAME=nova-bot
# منفذ سيرفر الويب (Render يحدده تلقائياً)
PORT=3000
# مجلد حفظ البيانات المؤقتة
DATA_DIR=
# ===== 🌐 وضع البوت (مهم لقوانين الاستضافة) =====
# 0 (الافتراضي) = البوت **لسيرفر واحد فقط** (سيرفر نوفا) — يطلع من أي سيرفر ثاني فوراً
#     ✅ هذا المطلوب لمعظم استضافات البوتات المجانية (ممنوع «بوت عام» يخدم سيرفرات كثيرة)
# 1 = البوت لكل السيرفرات (نظام التفعيل من صفحة «السيرفرات 🌐»)
#     ⚠️ لا تحطه 1 إلا لو الاستضافة تسمح صريحاً بالبوتات العامة (VPS مثلاً)
PUBLIC_BOT=0
